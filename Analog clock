body {
  margin: 0;
  background-color: salmon;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: "Courier New", Courier, monospace;
}

img {
  width: 85px;
  position: absolute;
  left: 50%;
  top: 60px;
  transform: translateX(-50%);
  z-index: 2;
}

.clock {
  background-color: lightgray;
  height: 350px;
  width: 350px;
  border-radius: 50%;
  border: 5px solid darkgray;
  box-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);
  position: relative;
}

.numbers div {
  position: absolute;
  font-weight: bold;
  text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  color: lightgoldenrodyellow;
  font-size: 30px;
}

.twelve {
  left: 50%;
  transform: translateX(-50%);
  top: 5px;
}

.three {
  top: 50%;
  transform: translateY(-50%);
  right: 5px;
}

.six {
  left: 50%;
  transform: translateX(-50%);
  bottom: 5px;
}

.nine {
  top: 50%;
  transform: translateY(-50%);
  left: 5px;
}
.arrows {
  display: flex;
  height: 100%;
  width: 100%;
  align-items: center;
  justify-content: center;
}
.arrows::before {
  content: "";
  width: 35px;
  height: 35px;
  background-color: darkgreen;
  border-radius: 50%;
  z-index: 4;
  box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
}

.arrows div {
  height: 125px;
  width: 10px;
  background-color: white;
  position: absolute;
  bottom: 50%;
  border-radius: 50% 50% 0 0;
  transform-origin: bottom center;
  box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.7);
  z-index: 3;
}

.arrows .hours {
  height: 75px;
  transform: rotate(30deg);
}

.arrows .seconds {
  transform: rotate(260deg);
  background-color: goldenrod;
}
